# Copy to .env.local (development) or set in your hosting provider's environment
# settings (production). Never commit real values.

# Public URL of the site, with no trailing slash. Used for canonical URLs, the
# sitemap, Open Graph and structured data. Optional: defaults to
# https://lifeinitaliya.com; set it only for another host, such as staging.
NEXT_PUBLIC_SITE_URL=https://lifeinitaliya.com

# Contact form email delivery through Resend (https://resend.com).
# Server-only: never rename these with a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=
# Sender address. Its domain must be verified in Resend first (add the DNS
# records Resend shows for lifeinitaliya.com), for example:
# RESEND_FROM_EMAIL="Life in Italia <contact@lifeinitaliya.com>"
RESEND_FROM_EMAIL=
